    <!-- Footer Space -->
    <footer class="bg-slate-950 border-t border-slate-900 py-6 text-center text-xs text-slate-500">
        <p>&copy; 2026 MedBook Healthcare Technologies. Simulated user-facing patient portal UI. Designed for Agile Training & Analysis.</p>
    </footer>

    <script>
        // State variables
        let simState = 'integrated'; // 'integrated' or 'siloed'
        let inspectModeActive = false;
        
        // Active appointment details built by patient selection
        const appointmentData = {
            specialty: 'Cardiology',
            doctor: 'Dr. Catherine Pierce',
            date: null,
            time: null
        };

        // Simulated Jira & Confluence specifications database for the inspector
        const specDatabase = {
            'HOSP-101': {
                id: 'HOSP-101',
                type: 'HIPAA Verification Module',
                title: 'Patient Credential Encryption & Consent System',
                desc: 'Protects user identification keys and locks records using salt hash validation.',
                status: 'Linked & Verified',
                statusIcon: 'fa-solid fa-circle-check',
                statusColor: 'text-emerald-400',
                confTitle: 'Patient Security Protocols (Page 1)',
                confBody: 'Mandates standard AES-256 encryption validation keys and displays compliance guidelines to avoid system data leaks.',
                jiraTitle: 'HOSP-101: Implement Security Handshake',
                jiraBody: 'Developer backlog item defining server verification, hash rules, and salt configuration guidelines.',
                lesson: 'When linked correctly, developers configured encryption parameters exactly matching the compliance rules written in Confluence. In Siloed mode, developers built standard input text fields without proper backend hash guards, creating severe security alerts.'
            },
            'HOSP-102': {
                id: 'HOSP-102',
                type: 'Calendar Module',
                title: 'Interactive Consultation Selector Grid',
                desc: 'A visual availability calendar mapping hours and selecting booking slots.',
                status: 'Linked & Verified',
                statusIcon: 'fa-solid fa-circle-check',
                statusColor: 'text-emerald-400',
                confTitle: 'MedBook Design System - Accessibility (Page 2)',
                confBody: 'Specifies exact WCAG Contrast Ratio guidelines (minimum 4.5:1) for active and select states to serve low-vision patients.',
                jiraTitle: 'HOSP-102: Setup Doctor Booking Calendar',
                jiraBody: 'Construct grid UI and availability slots logic using reactive JavaScript events.',
                lesson: 'When integrated, the design team updated selection colors in the guidelines and developers automatically received active style updates. In Siloed mode, developers used gray colors on a light background, violating crucial web accessibility laws.'
            }
        };

        // Initialize state on window load
        window.onload = function() {
            setSimState('integrated');
        };

        // Controls simulated workspace alignment (Integrated vs. Siloed)
        function setSimState(state) {
            simState = state;
            const btnSiloed = document.getElementById('btn-state-siloed');
            const btnIntegrated = document.getElementById('btn-state-integrated');
            const padlock = document.getElementById('secure-padlock');
            const alertBar = document.getElementById('siloed-alert-bar');
            const appBadge = document.getElementById('app-version-badge');
            const contrastBanner = document.getElementById('contrast-fail-banner');
            const scoreText = document.getElementById('score-text');
            const hipaaStatus = document.getElementById('hipaa-status-badge');
            const hipaaSubtext = document.getElementById('hipaa-warning-subtext');

            if (state === 'siloed') {
                // UI changes for Siloed Chaos Mode
                btnSiloed.className = 'px-3 py-2.5 text-xs font-semibold rounded-xl border-rose-600/30 bg-rose-600/10 hover:bg-rose-600/20 text-rose-300 transition flex items-center justify-center space-x-1.5 shadow-lg shadow-rose-600/5';
                btnIntegrated.className = 'px-3 py-2.5 text-xs font-semibold rounded-xl border border-slate-800 hover:bg-slate-900 transition flex items-center justify-center space-x-1.5';
                
                padlock.className = 'fa-solid fa-triangle-exclamation text-[9px] text-rose-400 mr-1';
                alertBar.classList.remove('hidden');
                appBadge.innerText = 'Sync Error: Unlinked';
                appBadge.className = 'bg-slate-800 text-[10px] px-2 py-0.5 rounded text-rose-400 font-bold';
                
                contrastBanner.classList.remove('hidden');
                scoreText.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-500 mr-1.5 animate-pulse"></i> 33% (Siloed Conflict)';
                
                // Downgrade HIPAA badge
                hipaaStatus.className = 'text-[10px] bg-slate-900 border border-slate-800 text-rose-400 px-2 py-0.5 rounded-full font-semibold inline-flex items-center';
                hipaaStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-500 mr-1 animate-pulse"></i> HIPAA Leak Warning';
                
                hipaaSubtext.className = 'text-[10px] text-rose-400 flex items-center';
                hipaaSubtext.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-500 mr-1 animate-pulse"></i> Warning: Credentials transmitting as unencrypted plain-text!';

                // Inject unlinked state details if active element exists in inspector
                if (inspectModeActive) {
                    refreshInspectState();
                }
            } else {
                // UI changes for Integrated Sync Mode
                btnSiloed.className = 'px-3 py-2.5 text-xs font-semibold rounded-xl border border-slate-800 hover:bg-slate-900 transition flex items-center justify-center space-x-1.5';
                btnIntegrated.className = 'px-3 py-2.5 text-xs font-semibold rounded-xl border-indigo-600/30 bg-indigo-600/10 hover:bg-indigo-600/20 text-indigo-300 transition flex items-center justify-center space-x-1.5 shadow-lg shadow-indigo-600/5';
                
                padlock.className = 'fa-solid fa-lock text-[9px] text-emerald-400 mr-1';
                alertBar.classList.add('hidden');
                appBadge.innerText = 'Active Link: Enabled';
                appBadge.className = 'bg-slate-800 text-[10px] px-2 py-0.5 rounded text-indigo-400 font-bold';
                
                contrastBanner.classList.add('hidden');
                scoreText.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-400 mr-1.5"></i> 100% (Integrated)';
                
                // Restore HIPAA Badge
                hipaaStatus.className = 'text-[10px] bg-slate-900 border border-slate-800 text-slate-300 px-2 py-0.5 rounded-full font-semibold inline-flex items-center';
                hipaaStatus.innerHTML = '<i class="fa-solid fa-shield-halved text-emerald-400 mr-1"></i> HIPAA Compliant';
                
                hipaaSubtext.className = 'text-[10px] text-slate-500 flex items-center';
                hipaaSubtext.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i> Standard AES-256 bit salt-hash validation verified active.';

                if (inspectModeActive) {
                    refreshInspectState();
                }
            }
        }

        // Toggles active glowing outline parameters for Agile Inspect mode
        function toggleInspectMode() {
            const checkbox = document.getElementById('inspect-toggle-checkbox');
            inspectModeActive = checkbox.checked;
            
            const calendarBox = document.getElementById('interactive-calendar-box');
            const securityBox = document.getElementById('interactive-security-box');

            if (inspectModeActive) {
                calendarBox.classList.add('inspect-highlight-jira');
                securityBox.classList.add('inspect-highlight-conf');
            } else {
                calendarBox.classList.remove('inspect-highlight-jira');
                securityBox.classList.remove('inspect-highlight-conf');
                document.getElementById('inspector-content').classList.add('hidden');
                document.getElementById('inspector-placeholder').classList.remove('hidden');
            }
        }

        // Select specialty department and go to Step 2 (Calendar)
        function selectDepartment(dept, doc) {
            appointmentData.specialty = dept;
            appointmentData.doctor = doc;
            
            document.getElementById('selected-doctor-subtext').innerText = `Appointment with ${doc} (${dept})`;
            document.getElementById('receipt-dept').innerText = dept;
            document.getElementById('receipt-doctor').innerText = doc;

            nextScreen(2);
        }

        // Handle specific calendar choices
        function selectDate(day) {
            appointmentData.date = `July ${day}, 2026`;
            document.getElementById('receipt-date').innerText = appointmentData.date;
            
            // Toggle highlight status in date buttons
            const dateButtons = document.querySelectorAll('.date-btn');
            dateButtons.forEach(btn => btn.className = 'py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn');
            
            const activeBtn = document.getElementById(`date-btn-${day}`);
            activeBtn.className = 'py-2 rounded-lg bg-indigo-600 text-white font-bold date-btn';
            
            checkCalendarSelections();
        }

        function selectTime(time) {
            appointmentData.time = time;
            document.getElementById('receipt-time').innerText = time;

            // Toggle highlights inside the simulated timeline
            const timeButtons = document.querySelectorAll('.time-btn');
            timeButtons.forEach(btn => btn.className = 'py-2 rounded-lg text-center font-bold bg-slate-950 hover:bg-indigo-600 text-slate-300 hover:text-white transition time-btn');
            
            let btnId = '';
            if (time.startsWith('09')) btnId = 'time-btn-9';
            else if (time.startsWith('11')) btnId = 'time-btn-11';
            else btnId = 'time-btn-2';

            const activeBtn = document.getElementById(btnId);
            activeBtn.className = 'py-2 rounded-lg text-center font-bold bg-indigo-600 text-white time-btn';

            checkCalendarSelections();
        }

        // Enable navigation to identity verification when options are selected
        function checkCalendarSelections() {
            const btn = document.getElementById('btn-submit-calendar');
            if (appointmentData.date && appointmentData.time) {
                btn.removeAttribute('disabled');
                btn.className = 'bg-indigo-600 hover:bg-indigo-500 cursor-pointer text-white font-bold text-xs px-5 py-2.5 rounded-xl transition flex items-center space-x-1 shadow-lg shadow-indigo-600/20';
            }
        }

        // Manage portal navigation logic
        function nextScreen(step) {
            // Hide all sub-views
            document.getElementById('screen-1-dept').classList.add('hidden');
            document.getElementById('screen-2-calendar').classList.add('hidden');
            document.getElementById('screen-3-hipaa').classList.add('hidden');
            document.getElementById('screen-4-success').classList.add('hidden');

            // Show current active sub-view
            if (step === 1) document.getElementById('screen-1-dept').classList.remove('hidden');
            else if (step === 2) document.getElementById('screen-2-calendar').classList.remove('hidden');
            else if (step === 3) document.getElementById('screen-3-hipaa').classList.remove('hidden');
            else if (step === 4) document.getElementById('screen-4-success').classList.remove('hidden');

            // Update step bars
            for (let i = 1; i <= 4; i++) {
                const tracker = document.getElementById(`step-tracker-${i}`);
                if (i <= step) {
                    tracker.className = 'h-1.5 rounded-full bg-indigo-600';
                } else {
                    tracker.className = 'h-1.5 rounded-full bg-slate-800';
                }
            }
        }

        function prevScreen(step) {
            nextScreen(step);
        }

        function restartBooking() {
            // Reset state parameters
            appointmentData.date = null;
            appointmentData.time = null;
            
            const dateButtons = document.querySelectorAll('.date-btn');
            dateButtons.forEach(btn => btn.className = 'py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn');
            
            const timeButtons = document.querySelectorAll('.time-btn');
            timeButtons.forEach(btn => btn.className = 'py-2 rounded-lg text-center font-bold bg-slate-950 hover:bg-indigo-600 text-slate-300 hover:text-white transition time-btn');

            document.getElementById('btn-submit-calendar').className = 'bg-slate-800 text-slate-500 cursor-not-allowed font-bold text-xs px-5 py-2.5 rounded-xl transition flex items-center space-x-1';
            document.getElementById('btn-submit-calendar').setAttribute('disabled', 'true');
            document.getElementById('input-security-pin').value = '';

            nextScreen(1);
        }

        // Trigger information details into the sidebar drawer
        let lastInspectedId = 'HOSP-102'; // track selection state
        
        function triggerInspect(id) {
            if (!inspectModeActive) return; // ignore clicks if inspect toggle is disabled
            
            lastInspectedId = id;
            refreshInspectState();
        }

        function refreshInspectState() {
            const data = specDatabase[lastInspectedId];
            if (!data) return;

            document.getElementById('inspector-placeholder').classList.add('hidden');
            document.getElementById('inspector-content').classList.remove('hidden');

            // Set content parameters
            document.getElementById('inspect-element-type-badge').innerText = data.type;
            document.getElementById('inspect-ticket-id').innerText = data.id;
            document.getElementById('inspect-title').innerText = data.title;
            document.getElementById('inspect-desc').innerText = data.desc;
            document.getElementById('inspect-conf-title').innerText = data.confTitle;
            document.getElementById('inspect-jira-title').innerText = data.jiraTitle;

            const statusIcon = document.getElementById('inspect-status-icon');
            const statusTxt = document.getElementById('inspect-status-txt');

            if (simState === 'siloed') {
                statusIcon.className = 'fa-solid fa-triangle-exclamation text-rose-500 animate-pulse mr-1';
                statusTxt.innerText = 'Unlinked Conflict';
                statusTxt.parentElement.className = 'text-[10px] bg-rose-500/10 text-rose-400 px-2 py-0.5 rounded-full font-bold flex items-center';

                if (lastInspectedId === 'HOSP-102') {
                    document.getElementById('inspect-conf-body').innerText = 'Requires color accessibility ratio minimum 4.5:1. Active state has specific hex requirements.';
                    document.getElementById('inspect-jira-body').innerText = 'Build schedule picker using gray select labels. (Developer did not see design WCAG requirements).';
                    document.getElementById('inspect-lesson').innerText = 'Unlinked Workflow Warning: Confluence specs were disconnected. Developers launched gray text styles on light-green fields, causing severe accessibility violations for patients with visual impairments.';
                } else {
                    document.getElementById('inspect-conf-body').innerText = 'Requires AES-256 bit secure salt-hashing parameter models to prevent credential logs from transmitting in plain text.';
                    document.getElementById('inspect-jira-body').innerText = 'Acceptance details define basic string matching for pin credentials (missed strict compliance hashing guidelines).';
                    document.getElementById('inspect-lesson').innerText = 'HIPAA Security Warning: The developer built an unencrypted password form. Because the security spec pages inside Confluence were never dynamically linked to Jira HOSP-101, compliance guidelines were completely ignored.';
                }
            } else {
                statusIcon.className = 'fa-solid fa-circle-check text-emerald-400 mr-1';
                statusTxt.innerText = 'Linked & Verified';
                statusTxt.parentElement.className = 'text-[10px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full font-bold flex items-center';

                document.getElementById('inspect-conf-body').innerText = data.confBody;
                document.getElementById('inspect-jira-body').innerText = data.jiraBody;
                document.getElementById('inspect-lesson').innerText = data.lesson;
            }
        }
    </script>
