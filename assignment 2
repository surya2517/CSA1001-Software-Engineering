<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedBook Patient Portal - Agile Inspector</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
        }
        /* Custom scrollbar for sleek UI */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        /* Pulse animations for the Agile Inspect Mode */
        @keyframes blueprint-pulse {
            0%, 100% { border-color: rgba(99, 102, 241, 0.6); box-shadow: 0 0 0 0px rgba(99, 102, 241, 0.4); }
            50% { border-color: rgba(99, 102, 241, 1); box-shadow: 0 0 12px 4px rgba(99, 102, 241, 0.3); }
        }
        .inspect-highlight-jira {
            animation: blueprint-pulse 2s infinite ease-in-out;
            cursor: pointer !important;
        }
        @keyframes blueprint-pulse-teal {
            0%, 100% { border-color: rgba(20, 184, 166, 0.6); box-shadow: 0 0 0 0px rgba(20, 184, 166, 0.4); }
            50% { border-color: rgba(20, 184, 166, 1); box-shadow: 0 0 12px 4px rgba(20, 184, 166, 0.3); }
        }
        .inspect-highlight-conf {
            animation: blueprint-pulse-teal 2s infinite ease-in-out;
            cursor: pointer !important;
        }
    </style>
</head>
<body class="min-h-screen text-slate-100 flex flex-col justify-between overflow-x-hidden">

    <!-- Navigation Bar -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="bg-indigo-600 p-2 rounded-xl text-white shadow-lg shadow-indigo-600/30">
                        <i class="fa-solid fa-hospital text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-base sm:text-lg font-bold text-white tracking-tight">MedBook</h1>
                        <p class="text-[10px] text-indigo-400 font-semibold tracking-widest uppercase">Patient Care & Alignment Hub</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="hidden sm:inline-flex items-center text-xs bg-slate-800 border border-slate-700 text-slate-300 px-3 py-1.5 rounded-full font-medium">
                        <i class="fa-solid fa-graduation-cap text-indigo-400 mr-2"></i>Interactive App Spec Guide
                    </span>
                    <a href="#explain-section" class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold underline">Conflict Case Study Specs</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Workbench Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- LEFT SIDE: THE AGILE CONTROL CENTER (Explaining the Problem, Conflict, and Integration) -->
        <section class="lg:col-span-5 flex flex-col justify-between space-y-6">
            
            <!-- Quick Context Card -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl"></div>
                
                <span class="bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                    Interactive Workspace Context
                </span>
                <h2 class="text-xl font-bold mt-3 text-white leading-tight">Patient App vs. Team Alignment</h2>
                <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                    How does a communication silo in developer logs and designer requirements damage patient experience? Toggle between <strong>Siloed Chaos</strong> and <strong>Integrated Sync</strong> on the right to preview how real-time requirements linking protects actual application users.
                </p>

                <!-- Mode Selector Controls -->
                <div class="mt-5 bg-slate-950 p-4 rounded-2xl border border-slate-800">
                    <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Simulated Workspace State:</label>
                    <div class="grid grid-cols-2 gap-2 mt-2">
                        <button onclick="setSimState('siloed')" id="btn-state-siloed" class="px-3 py-2.5 text-xs font-semibold rounded-xl border border-slate-800 hover:bg-slate-900 transition flex items-center justify-center space-x-1.5">
                            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                            <span class="text-slate-300">Siloed Chaos</span>
                        </button>
                        <button onclick="setSimState('integrated')" id="btn-state-integrated" class="px-3 py-2.5 text-xs font-semibold rounded-xl border-indigo-600/30 bg-indigo-600/10 hover:bg-indigo-600/20 text-indigo-300 transition flex items-center justify-center space-x-1.5 shadow-lg shadow-indigo-600/5">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                            <span class="text-white">Integrated Sync</span>
                        </button>
                    </div>
                </div>

                <!-- Inspect Mode Selector Toggle -->
                <div class="mt-4 flex items-center justify-between bg-slate-950/50 p-3 rounded-xl border border-slate-800/60">
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid fa-magnifying-glass-chart text-indigo-400"></i>
                        <span class="text-xs text-slate-300">Enable Agile "Inspect" Mode</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="inspect-toggle-checkbox" class="sr-only peer" onchange="toggleInspectMode()">
                        <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 peer-checked:after:bg-white"></div>
                    </label>
                </div>
            </div>

            <!-- Inspect Details Drawer (Loads metadata when clicking active elements in inspect mode) -->
            <div id="inspector-drawer" class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl flex-grow flex flex-col justify-between">
                <div id="inspector-placeholder" class="text-center py-12">
                    <div class="bg-slate-950/60 w-12 h-12 rounded-full flex items-center justify-center mx-auto text-slate-500">
                        <i class="fa-solid fa-hand-pointer text-lg"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-300 mt-3">Ready to Inspect App Elements</h3>
                    <p class="text-xs text-slate-500 max-w-xs mx-auto mt-1">
                        Turn on "Inspect Mode" above, then click any highlighted element inside the Patient Portal on the right to inspect its Jira & Confluence link configuration.
                    </p>
                </div>

                <!-- Active Inspect Content -->
                <div id="inspector-content" class="hidden space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div class="flex items-center space-x-2">
                            <span id="inspect-element-type-badge" class="bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
                                Calendar Module
                            </span>
                            <span class="text-[10px] text-slate-400 font-mono" id="inspect-ticket-id">HOSP-102</span>
                        </div>
                        <span class="text-[10px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full font-bold flex items-center">
                            <i class="fa-solid fa-link-slash mr-1 text-[8px]" id="inspect-status-icon"></i> <span id="inspect-status-txt">Linked & Verified</span>
                        </span>
                    </div>

                    <!-- App Element Title & Impact -->
                    <div>
                        <h4 class="text-sm font-bold text-white" id="inspect-title">Doctor Scheduling Grid Element</h4>
                        <p class="text-xs text-slate-400 mt-1" id="inspect-desc">How this section represents the user interface designed for patients.</p>
                    </div>

                    <!-- Two-Column Dev vs Design Specs -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <!-- Confluence Space Side -->
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
                            <div class="flex items-center text-teal-400 space-x-1.5 mb-1.5">
                                <i class="fa-brands fa-confluence text-xs"></i>
                                <span class="text-[10px] font-bold uppercase tracking-wider">Confluence Spec</span>
                            </div>
                            <p class="text-[11px] font-semibold text-slate-200" id="inspect-conf-title">UX/UI Specification Document</p>
                            <p class="text-[10px] text-slate-400 mt-1 leading-relaxed" id="inspect-conf-body">Design rules, layout scale guide, and compliance values.</p>
                        </div>

                        <!-- Jira Task Side -->
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
                            <div class="flex items-center text-blue-400 space-x-1.5 mb-1.5">
                                <i class="fa-brands fa-jira text-xs"></i>
                                <span class="text-[10px] font-bold uppercase tracking-wider">Jira Sprint Backlog</span>
                            </div>
                            <p class="text-[11px] font-semibold text-slate-200" id="inspect-jira-title">Sprint Implementation Story</p>
                            <p class="text-[10px] text-slate-400 mt-1 leading-relaxed" id="inspect-jira-body">Acceptance criteria, code guidelines, testing specs.</p>
                        </div>
                    </div>

                    <!-- Alignment Lesson Learned -->
                    <div class="bg-indigo-500/5 border border-indigo-500/10 p-3 rounded-xl">
                        <h5 class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest flex items-center">
                            <i class="fa-solid fa-circle-info mr-1.5"></i> Conflict Resolved
                        </h5>
                        <p class="text-[11px] text-slate-300 mt-1 leading-relaxed" id="inspect-lesson">
                            Direct linking ensured that when designers changed contrast requirements to hit regulatory targets, development was instantly flagged of the change before final deployment.
                        </p>
                    </div>
                </div>

                <div class="border-t border-slate-800/80 pt-4 mt-4 flex items-center justify-between text-xs text-slate-500">
                    <span>Alignment Health Score:</span>
                    <span class="font-mono font-bold text-slate-300 flex items-center" id="score-text">
                        <i class="fa-solid fa-circle-check text-emerald-400 mr-1.5"></i>100% (Integrated)
                    </span>
                </div>
            </div>
        </section>

        <!-- RIGHT SIDE: THE PATIENT APPLICATION VIEW (MEDBOOK APP FRAME) -->
        <section class="lg:col-span-7 flex flex-col space-y-4">
            
            <!-- Sleek Device Shell Simulation Container -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl flex flex-col min-h-[640px]">
                
                <!-- Mock App Browser Top Bar -->
                <div class="bg-slate-950 px-4 py-3 border-b border-slate-800 flex items-center justify-between">
                    <div class="flex items-center space-x-1.5">
                        <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                    </div>
                    <div class="bg-slate-900 rounded-lg px-4 py-1 text-[11px] text-slate-400 font-mono tracking-wide w-1/2 text-center truncate flex items-center justify-center space-x-1">
                        <i class="fa-solid fa-lock text-[9px] text-emerald-400 mr-1" id="secure-padlock"></i>
                        <span>https://medbook-portal.org/secure-booking</span>
                    </div>
                    <div class="text-xs text-slate-400 flex items-center space-x-2">
                        <span class="bg-slate-800 text-[10px] px-2 py-0.5 rounded text-indigo-400 font-bold" id="app-version-badge">Active Link: Enabled</span>
                    </div>
                </div>

                <!-- Siloed Crisis Toast Warning (Only visible when Siloed Mode is active) -->
                <div id="siloed-alert-bar" class="hidden bg-rose-950/80 border-b border-rose-800 px-4 py-2.5 text-xs text-rose-200 flex items-center space-x-2 animate-pulse">
                    <i class="fa-solid fa-triangle-exclamation text-rose-400"></i>
                    <span><strong>Siloed Chaos Active:</strong> Design elements in Confluence are disconnected from Jira build guidelines. Expect UI bugs and security compliance warnings.</span>
                </div>

                <!-- App Main Frame Body -->
                <div class="bg-slate-950 p-4 sm:p-6 flex-grow flex flex-col justify-between">
                    
                    <!-- Patient User Header -->
                    <div class="flex justify-between items-center mb-6">
                        <div class="flex items-center space-x-2.5">
                            <div class="bg-slate-800 h-10 w-10 rounded-full flex items-center justify-center text-slate-300 font-bold border border-slate-700">
                                <i class="fa-solid fa-user-injured text-sm"></i>
                            </div>
                            <div>
                                <h4 class="text-xs text-slate-400">Welcome Patient</h4>
                                <p class="text-sm font-bold text-white">Alex Mercer</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] text-slate-500">Security Standard</p>
                            <span class="text-[10px] bg-slate-900 border border-slate-800 text-slate-300 px-2 py-0.5 rounded-full font-semibold inline-flex items-center" id="hipaa-status-badge">
                                <i class="fa-solid fa-shield-halved text-emerald-400 mr-1"></i> HIPAA Compliant
                            </span>
                        </div>
                    </div>

                    <!-- STEP PROGRESS TRACKER -->
                    <div class="grid grid-cols-4 gap-1 mb-6">
                        <div id="step-tracker-1" class="h-1.5 rounded-full bg-indigo-600"></div>
                        <div id="step-tracker-2" class="h-1.5 rounded-full bg-slate-800"></div>
                        <div id="step-tracker-3" class="h-1.5 rounded-full bg-slate-800"></div>
                        <div id="step-tracker-4" class="h-1.5 rounded-full bg-slate-800"></div>
                    </div>

                    <!-- DYNAMIC PATIENT BOOKING SCREENS CONTENT -->
                    <div class="flex-grow flex flex-col justify-between min-h-[360px]" id="booking-screens-container">
                        
                        <!-- SCREEN 1: CHOOSE DEPARTMENT & DISCOVERY -->
                        <div id="screen-1-dept" class="space-y-4">
                            <div class="mb-2">
                                <h3 class="text-base font-bold text-white">Select Clinic Specialty</h3>
                                <p class="text-xs text-slate-400">Choose the medical team specialization for your concern.</p>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div onclick="selectDepartment('Cardiology', 'Dr. Catherine Pierce')" class="group cursor-pointer p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-indigo-500 hover:bg-slate-900/60 transition flex items-start space-x-3">
                                    <div class="bg-rose-500/10 text-rose-400 p-2.5 rounded-xl"><i class="fa-solid fa-heart-pulse"></i></div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-200">Cardiology Dept</h4>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Heart care & blood flow dynamics</p>
                                    </div>
                                </div>

                                <div onclick="selectDepartment('Pediatrics', 'Dr. Aris Thorne')" class="group cursor-pointer p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-indigo-500 hover:bg-slate-900/60 transition flex items-start space-x-3">
                                    <div class="bg-amber-500/10 text-amber-400 p-2.5 rounded-xl"><i class="fa-solid fa-baby"></i></div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-200">Pediatrics Care</h4>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Child growth & wellness reviews</p>
                                    </div>
                                </div>

                                <div onclick="selectDepartment('General Medicine', 'Dr. Sarah Vance')" class="group cursor-pointer p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-indigo-500 hover:bg-slate-900/60 transition flex items-start space-x-3">
                                    <div class="bg-emerald-500/10 text-emerald-400 p-2.5 rounded-xl"><i class="fa-solid fa-stethoscope"></i></div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-200">General Practice</h4>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Physical checkups & baseline panels</p>
                                    </div>
                                </div>

                                <div onclick="selectDepartment('Dermatology', 'Dr. Maya Lin')" class="group cursor-pointer p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-indigo-500 hover:bg-slate-900/60 transition flex items-start space-x-3">
                                    <div class="bg-teal-500/10 text-teal-400 p-2.5 rounded-xl"><i class="fa-solid fa-hand-holding-medical"></i></div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-200">Dermatology Dept</h4>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Skin wellness & therapeutic care</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SCREEN 2: BOOKING DATE & TIME CALENDAR (HOSP-102 Component) -->
                        <div id="screen-2-calendar" class="hidden space-y-4">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h3 class="text-base font-bold text-white">Select Slot Calendar</h3>
                                    <p class="text-xs text-slate-400" id="selected-doctor-subtext">Booking appointment with Specialist</p>
                                </div>
                                <button onclick="prevScreen(1)" class="text-xs text-slate-500 hover:text-slate-300">
                                    <i class="fa-solid fa-chevron-left mr-1"></i> Back
                                </button>
                            </div>

                            <!-- Interactive Component Frame: Scheduled Module -->
                            <div id="interactive-calendar-box" onclick="triggerInspect('HOSP-102')" class="p-4 rounded-2xl bg-slate-900 border border-slate-800 relative transition duration-200">
                                
                                <span class="absolute top-2 right-2 text-[8px] bg-indigo-500/10 text-indigo-400 px-1.5 py-0.5 rounded border border-indigo-500/20 pointer-events-none opacity-80 uppercase tracking-widest font-mono">
                                    HOSP-102 Calendar Module
                                </span>

                                <div class="grid grid-cols-7 gap-2 text-center text-[10px] text-slate-400 font-bold mb-2">
                                    <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                                </div>
                                <div class="grid grid-cols-7 gap-1.5 text-center text-xs text-slate-200">
                                    <button class="py-2 rounded-lg bg-slate-950/40 text-slate-600 cursor-not-allowed">20</button>
                                    <button class="py-2 rounded-lg bg-slate-950/40 text-slate-600 cursor-not-allowed">21</button>
                                    <button onclick="selectDate(22)" class="py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn" id="date-btn-22">22</button>
                                    <button onclick="selectDate(23)" class="py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn" id="date-btn-23">23</button>
                                    <button onclick="selectDate(24)" class="py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn" id="date-btn-24">24</button>
                                    <button onclick="selectDate(25)" class="py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn" id="date-btn-25">25</button>
                                    <button onclick="selectDate(26)" class="py-2 rounded-lg bg-slate-950 hover:bg-indigo-600 hover:text-white transition date-btn" id="date-btn-26">26</button>
                                </div>

                                <!-- Time selection buttons inside the calendar module -->
                                <div class="mt-4 pt-3 border-t border-slate-800">
                                    <p class="text-[11px] text-slate-400 mb-2 font-semibold">Available Hours (AODA Compliant Contrast)</p>
                                    <div class="grid grid-cols-3 gap-2 text-xs" id="time-slots-grid">
                                        <!-- Will render style variations depending on state -->
                                        <button onclick="selectTime('09:00 AM')" class="py-2 rounded-lg text-center font-bold bg-slate-950 hover:bg-indigo-600 text-slate-300 hover:text-white transition time-btn" id="time-btn-9">09:00 AM</button>
                                        <button onclick="selectTime('11:30 AM')" class="py-2 rounded-lg text-center font-bold bg-slate-950 hover:bg-indigo-600 text-slate-300 hover:text-white transition time-btn" id="time-btn-11">11:30 AM</button>
                                        <button onclick="selectTime('02:15 PM')" class="py-2 rounded-lg text-center font-bold bg-slate-950 hover:bg-indigo-600 text-slate-300 hover:text-white transition time-btn" id="time-btn-2">02:15 PM</button>
                                    </div>
                                    <div id="contrast-fail-banner" class="hidden mt-2 bg-amber-500/15 border border-amber-500/20 p-2 rounded-lg text-[10px] text-amber-300 flex items-center">
                                        <i class="fa-solid fa-triangle-exclamation mr-1.5 shrink-0"></i>
                                        <span>Accessibility Contrast Error: Gray text on light green select states violates WCAG Guidelines.</span>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-2 flex justify-end">
                                <button onclick="nextScreen(3)" id="btn-submit-calendar" disabled class="bg-slate-800 text-slate-500 cursor-not-allowed font-bold text-xs px-5 py-2.5 rounded-xl transition flex items-center space-x-1">
                                    <span>Continue to Identity Verification</span>
                                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                </button>
                            </div>
                        </div>

                        <!-- SCREEN 3: SECURITY VERIFICATION & DATA CONSTRAINTS (HOSP-101 Component) -->
                        <div id="screen-3-hipaa" class="hidden space-y-4">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h3 class="text-base font-bold text-white">HIPAA Verification & Consent</h3>
                                    <p class="text-xs text-slate-400">Validate security protocol encryption key logs to secure slot.</p>
                                </div>
                                <button onclick="prevScreen(2)" class="text-xs text-slate-500 hover:text-slate-300">
                                    <i class="fa-solid fa-chevron-left mr-1"></i> Back
                                </button>
                            </div>

                            <!-- Interactive Component Frame: HIPAA Module -->
                            <div id="interactive-security-box" onclick="triggerInspect('HOSP-101')" class="p-4 rounded-2xl bg-slate-900 border border-slate-800 relative transition duration-200 space-y-3">
                                
                                <span class="absolute top-2 right-2 text-[8px] bg-indigo-500/10 text-indigo-400 px-1.5 py-0.5 rounded border border-indigo-500/20 pointer-events-none opacity-80 uppercase tracking-widest font-mono">
                                    HOSP-101 HIPAA Module
                                </span>

                                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-[11px] text-slate-400 leading-relaxed">
                                    <i class="fa-solid fa-shield-halved text-emerald-400 mr-1.5"></i>
                                    To protect health credentials, entering safety compliance values maps securely back to encrypt keys on record.
                                </div>

                                <div class="space-y-2">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Security Pin (Patient verification key):</label>
                                    <div class="relative">
                                        <input type="password" id="input-security-pin" placeholder="Enter Secure Pin" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 transition font-mono tracking-widest">
