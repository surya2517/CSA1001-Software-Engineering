<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SirenNet - AI-Powered Real-Time Crash Detection & Dispatch</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
                            400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
                            800: '#075985', 900: '#0c4a6e', 950: '#032f4c'
                        },
                        danger: {
                            500: '#ef4444', 600: '#dc2626', 700: '#b91c1c'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Fira Code', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for high-fidelity real-time charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
        }
        .glow-red {
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.45);
        }
        .glow-green {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
        }
        .glow-amber {
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.35);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #111827;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="text-slate-100 min-h-screen flex flex-col antialiased selection:bg-rose-500 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur-md sticky top-0 z-50 px-4 py-3 sm:px-6">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-rose-500/10 rounded-xl border border-rose-500/30 flex items-center justify-center animate-pulse">
                    <i class="fa-solid fa-truck-medical text-rose-500 text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold tracking-tight text-white">SirenNet <span class="text-rose-500">AI</span></h1>
                        <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full font-mono">v3.0-Production</span>
                    </div>
                    <p class="text-xs text-slate-400">Crash Detection &amp; Autonomous Triage System</p>
                </div>
            </div>

            <!-- Global Stats / Quick Monitor Metrics -->
            <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm">
                <div class="bg-slate-950/60 border border-slate-800/80 px-3 py-1.5 rounded-lg flex items-center gap-2">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span class="text-slate-300 font-medium">IoT Hub Connected</span>
                </div>
                
                <div class="bg-slate-950/60 border border-slate-800/80 px-3 py-1.5 rounded-lg flex items-center gap-2">
                    <i class="fa-solid fa-microchip text-slate-400"></i>
                    <span class="text-slate-300">Edge Classifier: </span>
                    <span class="text-cyan-400 font-semibold font-mono">ONNX-LSTM-99.4%</span>
                </div>

                <div class="flex items-center bg-slate-950/80 border border-slate-850 px-2 py-1 rounded-lg">
                    <button onclick="toggleAudioMute()" id="mute-btn" class="text-slate-400 hover:text-rose-400 px-1.5 transition" title="Toggle System Voice Alerts">
                        <i class="fa-solid fa-volume-high text-rose-400" id="audio-icon"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Dynamic Parameters Control Bar -->
    <section class="bg-slate-950/80 border-b border-slate-900 px-4 py-3 sm:px-6">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4 text-xs">
            <div class="flex flex-wrap items-center gap-6 w-full lg:w-auto">
                <!-- Speed Slider -->
                <div class="flex items-center gap-2 bg-slate-900/60 px-3 py-1.5 rounded-lg border border-slate-800">
                    <span class="text-slate-400">Baseline Speed:</span>
                    <input type="range" id="param-speed" min="20" max="140" value="72" oninput="updateConfig('speed', this.value)" class="w-24 accent-rose-500 bg-slate-950 h-1 rounded-lg cursor-pointer">
                    <span id="param-speed-val" class="font-mono text-yellow-400 font-bold">72 km/h</span>
                </div>

                <!-- Noise/Vibration Level -->
                <div class="flex items-center gap-2 bg-slate-900/60 px-3 py-1.5 rounded-lg border border-slate-800">
                    <span class="text-slate-400">Road Noise:</span>
                    <input type="range" id="param-noise" min="0" max="100" value="15" oninput="updateConfig('noise', this.value)" class="w-20 accent-cyan-500 bg-slate-950 h-1 rounded-lg cursor-pointer">
                    <span id="param-noise-val" class="font-mono text-cyan-400 font-bold">15%</span>
                </div>

                <!-- G-Threshold -->
                <div class="flex items-center gap-2 bg-slate-900/60 px-3 py-1.5 rounded-lg border border-slate-800">
                    <span class="text-slate-400">ML Alert Trigger:</span>
                    <input type="range" id="param-threshold" min="30" max="90" value="55" step="5" oninput="updateConfig('threshold', this.value)" class="w-24 accent-amber-500 bg-slate-950 h-1 rounded-lg cursor-pointer">
                    <span id="param-threshold-val" class="font-mono text-amber-400 font-bold">5.5 G</span>
                </div>
            </div>

            <!-- Controller Toggles -->
            <div class="flex items-center gap-2">
                <button onclick="toggleSimulationRun()" id="sim-run-btn" class="bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-lg text-white font-semibold flex items-center gap-1.5 transition shadow">
                    <i id="sim-run-icon" class="fa-solid fa-pause"></i>
                    <span id="sim-run-text">Pause Stream</span>
                </button>
                <button onclick="resetSimulationMetrics()" class="bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg text-slate-300 border border-slate-700 hover:text-white transition">
                    <i class="fa-solid fa-rotate-right"></i> Reset Stats
                </button>
            </div>
        </div>
    </section>

    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- ================= LEFT GRID: TELEMETRY GENERATOR & EDGE AI (5 COLS) ================= -->
        <section class="lg:col-span-5 flex flex-col gap-6">
            
            <!-- STAGE 1: Control Center & Scenario Presets -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-semibold text-sm uppercase tracking-wider text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-primary-500"></i>
                        1. Interactive Driver Simulation
                    </h3>
                    <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full">Interactive Edge Sim</span>
                </div>

                <p class="text-xs text-slate-400 mb-4">
                    Select a predetermined driver behavior below, or use the sliders above to fine-tune raw hardware events.
                </p>

                <!-- Preset Action Buttons -->
                <div class="grid grid-cols-2 gap-2 mb-4">
                    <button onclick="setScenario('normal')" id="btn-normal" class="scenario-btn p-3 rounded-xl bg-slate-800 border border-slate-700 hover:bg-slate-750 flex flex-col items-start gap-1 transition text-left">
                        <span class="text-xs font-semibold text-slate-200 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Normal Drive
                        </span>
                        <span class="text-[10px] text-slate-400">Regular cruising, minor vibration</span>
                    </button>

                    <button onclick="setScenario('brake')" id="btn-brake" class="scenario-btn p-3 rounded-xl bg-slate-800 border border-slate-700 hover:bg-slate-750 flex flex-col items-start gap-1 transition text-left">
                        <span class="text-xs font-semibold text-slate-200 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span> Heavy Braking
                        </span>
                        <span class="text-[10px] text-slate-400">High speed deceleration</span>
                    </button>

                    <button onclick="setScenario('pothole')" id="btn-pothole" class="scenario-btn p-3 rounded-xl bg-slate-800 border border-slate-700 hover:bg-slate-750 flex flex-col items-start gap-1 transition text-left">
                        <span class="text-xs font-semibold text-slate-200 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-600"></span> Deep Pothole
                        </span>
                        <span class="text-[10px] text-slate-400">Impact bump, fast recovery</span>
                    </button>

                    <button onclick="setScenario('crash')" id="btn-crash" class="scenario-btn p-3 rounded-xl bg-rose-500/20 border border-rose-500/30 hover:bg-rose-500/30 flex flex-col items-start gap-1 transition text-left glow-red animate-pulse">
                        <span class="text-xs font-bold text-rose-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-triangle-exclamation text-rose-400 animate-bounce"></i> Trigger Crash
                        </span>
                        <span class="text-[10px] text-rose-400/90 font-medium">8.4G severe multi-axis impact</span>
                    </button>
                </div>

                <!-- Custom Manual Overrides & Networking State -->
                <div class="border-t border-slate-800 pt-4 mt-4">
                    <label class="block text-xs font-medium text-slate-400 mb-2 uppercase tracking-wider">Edge-Case Network Router</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button onclick="setNetwork('online')" id="net-online" class="net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-emerald-500/10 border-emerald-500/40 text-emerald-400">
                            <i class="fa-solid fa-wifi"></i>
                            <span>Online (5G)</span>
                        </button>
                        <button onclick="setNetwork('weak')" id="net-weak" class="net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-slate-800 border-slate-700 text-slate-400 hover:bg-slate-750">
                            <i class="fa-solid fa-signal"></i>
                            <span>Weak (Data Loss)</span>
                        </button>
                        <button onclick="setNetwork('offline')" id="net-offline" class="net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-slate-800 border-slate-700 text-slate-400 hover:bg-slate-750">
                            <i class="fa-solid fa-ban"></i>
                            <span>Offline (SMS Hub)</span>
                        </button>
                    </div>
                    <div class="mt-3 flex justify-between items-center text-[11px] bg-slate-950/60 p-2.5 rounded-lg border border-slate-850">
                        <span class="text-slate-400">Buffer Queue (Data Resilience Mode):</span>
                        <span id="buffer-count" class="font-mono font-bold text-cyan-400">0 packets</span>
                    </div>
                </div>
            </div>

            <!-- LIVE TELEMETRY CHART CARD -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm shadow-xl flex-1 flex flex-col min-h-[320px]">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-sm uppercase tracking-wider text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-emerald-400"></i>
                        Real-Time Sensor Telemetry
                    </h3>
                    <div class="flex gap-2">
                        <span class="text-[10px] font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2 py-0.5 rounded">100Hz Stream</span>
                    </div>
                </div>

                <!-- Live Digital Readouts -->
                <div class="grid grid-cols-3 gap-3 mb-4">
                    <div class="bg-slate-950/50 p-2.5 rounded-xl border border-slate-800/80 text-center hover:border-emerald-500/45 transition">
                        <p class="text-[10px] text-slate-500 uppercase font-medium">Accelerometer (G)</p>
                        <p id="readout-g" class="text-lg font-bold font-mono text-emerald-400 mt-0.5">1.02 G</p>
                    </div>
                    <div class="bg-slate-950/50 p-2.5 rounded-xl border border-slate-800/80 text-center hover:border-cyan-500/45 transition">
                        <p class="text-[10px] text-slate-500 uppercase font-medium">Gyro (deg/s)</p>
                        <p id="readout-gyro" class="text-lg font-bold font-mono text-cyan-400 mt-0.5">4.2°</p>
                    </div>
                    <div class="bg-slate-950/50 p-2.5 rounded-xl border border-slate-800/80 text-center hover:border-yellow-500/45 transition">
                        <p class="text-[10px] text-slate-500 uppercase font-medium">Speed (km/h)</p>
                        <p id="readout-speed" class="text-lg font-bold font-mono text-yellow-400 mt-0.5">72 km</p>
                    </div>
                </div>

                <!-- Live Chart Container -->
                <div class="relative flex-1 min-h-[180px] w-full">
                    <canvas id="telemetryChart"></canvas>
                </div>
            </div>

            <!-- STAGE 2: Edge AI Processor / Classifier Model -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm shadow-xl">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-sm uppercase tracking-wider text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-brain text-violet-400"></i>
                        2. Edge ML Anomaly Classifier
                    </h3>
                </div>

                <!-- AI Output Screen -->
                <div id="ai-container" class="bg-slate-950/80 border border-slate-800 rounded-xl p-4 transition-all duration-300">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-[10px] text-slate-500 uppercase tracking-widest font-mono">ON-BOARD INFERENCE RUNNING</span>
                        <span id="ai-model-status" class="text-[10px] bg-emerald-500/15 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded font-mono">MODEL OK</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400">Classified State</p>
                            <h2 id="ai-status-label" class="text-xl font-bold tracking-wide text-emerald-400 mt-0.5">NORMAL DRIVING</h2>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-slate-400">Confidence</p>
                            <h2 id="ai-confidence-label" class="text-xl font-bold font-mono text-emerald-300 mt-0.5">99.2%</h2>
                        </div>
                    </div>

                    <div class="mt-3.5 bg-slate-900 rounded-lg p-2.5 border border-slate-800 flex flex-col gap-1.5 text-xs font-mono">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Feature Vector:</span>
                            <span id="feature-vector" class="text-slate-300">[1.01, 0.05, 72.0, 0.0]</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Local Latency:</span>
                            <span class="text-violet-400">4.12 ms</span>
                        </div>
                    </div>
                </div>

                <!-- CRASH SOS COUNTDOWN INTERFACE (FALSE-POSITIVE SHIELD) -->
                <div id="countdown-banner" class="hidden mt-4 bg-amber-500/10 border-2 border-amber-500/30 rounded-xl p-4 glow-amber animate-pulse">
                    <div class="flex flex-col sm:flex-row items-center gap-3">
                        <div class="w-12 h-12 rounded-full border-4 border-amber-500 border-t-transparent animate-spin flex items-center justify-center shrink-0">
                            <span id="countdown-timer" class="text-lg font-extrabold text-amber-400">10</span>
                        </div>
                        <div class="flex-1 text-center sm:text-left">
                            <h4 class="text-sm font-bold text-amber-300 uppercase">Crash Alert Pending Triage</h4>
                            <p class="text-xs text-slate-300 mt-0.5">Edge ML detected anomaly threshold breach. Dismiss to prevent dispatch.</p>
                        </div>
                        <button onclick="dismissCountdown()" class="w-full sm:w-auto bg-rose-500 hover:bg-rose-600 text-white text-xs px-3 py-2 rounded-lg font-bold transition">
                            DISMISS FALSE ALARM
                        </button>
                    </div>
                </div>
            </div>

            <!-- TTS Alert Customization Engine -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm shadow-xl">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                        <i class="fa-solid fa-bullhorn text-cyan-400"></i>
                        Vocal Dispatch Customizer
                    </h3>
                </div>
                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Speaker Pitch</label>
                        <input type="range" id="tts-pitch" min="0.5" max="1.5" step="0.1" value="1.0" class="w-full accent-rose-500 bg-slate-950 h-1 rounded cursor-pointer">
                    </div>
                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Speaker Speed</label>
                        <input type="range" id="tts-rate" min="0.6" max="1.6" step="0.1" value="1.1" class="w-full accent-cyan-500 bg-slate-950 h-1 rounded cursor-pointer">
                    </div>
                </div>
                <div class="mt-3 flex gap-2">
                    <button onclick="testCustomVoice()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg py-1.5 font-medium transition text-[11px]">
                        Test Custom Voice Output
                    </button>
                </div>
            </div>

        </section>

        <!-- ================= RIGHT GRID: REAL-TIME EMERGENCY ACTION COMMAND CENTER (7 COLS) ================= -->
        <section class="lg:col-span-7 flex flex-col gap-6">
            
            <!-- STAGE 3: Autonomous Incident Map Visualization -->
            <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm shadow-xl flex flex-col min-h-[380px] h-auto">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-3 gap-2">
                    <div>
                        <h3 class="font-semibold text-sm uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i class="fa-solid fa-map-location-dot text-rose-500 animate-bounce"></i>
                            Interactive GIS Route Dispatch Map
                        </h3>
                        <p class="text-[11px] text-slate-400 mt-0.5">Click or Tap anywhere on this map grid to manually relocate the car.</p>
                    </div>
                    <span id="map-status" class="text-xs text-slate-300 bg-slate-950/80 border border-slate-800 px-3 py-1 rounded-full flex items-center gap-1.5 self-start">
                        <i class="fa-solid fa-location-crosshairs text-sky-400 animate-spin"></i> Interactive GPS Mode
                    </span>
                </div>

                <!-- Simulation Interactive SVG/Canvas Map -->
                <div class="relative flex-1 bg-slate-950 rounded-xl border border-slate-800 overflow-hidden min-h-[220px]">
                    <canvas id="incidentMap" class="w-full h-full cursor-pointer"></canvas>
                    
                    <!-- Floating Map Legend Overlay -->
                    <div class="absolute bottom-3 left-3 bg-slate-900/95 backdrop-blur border border-slate-800 px-3 py-2 rounded-lg text-[10px] flex flex-wrap gap-3 text-slate-300 shadow">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Incident Zone</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-emerald-500"></span> Trauma Level 1</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-blue-500"></span> Level 2 Regional</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-amber-500"></span> Clinic</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse"></span> Dispatch Route</span>
                    </div>
                </div>
            </div>

            <!-- STAGE 4: Automated Dispatch Console & System Fallback Logs -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Active Incident Logs and Alert Queue -->
                <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm shadow-xl flex flex-col h-[400px]">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                        <h3 class="font-semibold text-sm uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-list-check text-rose-500"></i>
                            Console Streams
                        </h3>
                        
                        <!-- Log Filters -->
                        <div class="flex gap-1 bg-slate-950 p-0.5 rounded-lg border border-slate-850 self-start text-[10px]">
                            <button onclick="setLogFilter('all')" id="log-filter-all" class="px-2 py-0.5 rounded font-medium bg-slate-800 text-white">All</button>
                            <button onclick="setLogFilter('crisis')" id="log-filter-crisis" class="px-2 py-0.5 rounded font-medium text-slate-400">Crashes</button>
                            <button onclick="setLogFilter('system')" id="log-filter-system" class="px-2 py-0.5 rounded font-medium text-slate-400">System</button>
                        </div>
                    </div>

                    <div id="alert-logs" class="flex-1 overflow-y-auto space-y-2.5 pr-1">
                        <!-- Default empty state -->
                        <div id="logs-empty-state" class="h-full flex flex-col items-center justify-center text-center p-4">
                            <div class="w-12 h-12 rounded-full bg-slate-800/50 flex items-center justify-center text-slate-600 mb-2 border border-slate-800">
                                <i class="fa-solid fa-shield-halved text-xl animate-pulse"></i>
                            </div>
                            <p class="text-xs text-slate-400 font-medium">Ready &amp; Monitoring...</p>
                            <p class="text-[10px] text-slate-500 max-w-[180px] mt-1">No active incidents. Tap anywhere on map or trigger crash preset to start telemetry analytics.</p>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-slate-800 mt-2 flex justify-between items-center">
                        <span class="text-[9px] text-slate-500">Log Buffer Count: <span id="log-stat-count">0</span></span>
                        <button onclick="exportLogQueue()" class="text-[10px] text-cyan-400 hover:text-cyan-300 font-semibold transition flex items-center gap-1">
                            <i class="fa-solid fa-download"></i> Export Logs
                        </button>
                    </div>
                </div>

