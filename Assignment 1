    <!-- Application State & Control Script -->
    <script>
        
        // Application States
        const state = {
            scenario: 'normal', // normal, brake, pothole, crash
            network: 'online', // online, weak, offline
            bufferQueue: [], // telemetry buffered during low connection
            incidents: [], // array of processed incidents
            isCountdownActive: false,
            countdownTime: 10,
            countdownTimerId: null,
            simulationTicks: 0,
            isSimulationRunning: true,
            simCarX: 52, // simulated position percentages
            simCarY: 60,
            isAudioMuted: false,
            logFilter: 'all', // all, crisis, system
            config: {
                baselineSpeed: 72,
                noiseLevel: 15, // slider out of 100
                triggerThreshold: 5.5, // G Force threshold
            }
        };

        // Static GIS coordinates for Trauma Centers in the simulation map coordinates (will translate to responsive pixels)
        const hospitals = [
            { id: 1, name: 'Mercy Level 1 Trauma', xPct: 25, yPct: 30, beds: 14, totalBeds: 20, color: '#10b981', elementId: 'hospital-card-1' },
            { id: 2, name: 'St. Jude Regional', xPct: 75, yPct: 40, beds: 8, totalBeds: 15, color: '#3b82f6', elementId: 'hospital-card-2' },
            { id: 3, name: 'Hope General Clinic', xPct: 40, yPct: 80, beds: 2, totalBeds: 10, color: '#f59e0b', elementId: 'hospital-card-3' }
        ];

        // Active Incident Tracking
        let activeIncident = null;
        let logQueue = [];

        // Visual Coordinates setup
        let canvas, ctx;
        let chartInstance;
        const chartLength = 30;
        const chartLabels = Array.from({length: chartLength}, (_, i) => '');
        const chartDataAcc = Array(chartLength).fill(1.0);
        const chartDataGyro = Array(chartLength).fill(0.0);
        const chartDataSpeed = Array(chartLength).fill(72);

        // Initialize Real-time Charts
        function initChart() {
            const ctxChart = document.getElementById('telemetryChart').getContext('2d');
            chartInstance = new Chart(ctxChart, {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [
                        {
                            label: 'Force (G)',
                            data: chartDataAcc,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.05)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointRadius: 0
                        },
                        {
                            label: 'Gyro (°/s)',
                            data: chartDataGyro,
                            borderColor: '#06b6d4',
                            backgroundColor: 'transparent',
                            borderWidth: 1.5,
                            tension: 0.3,
                            pointRadius: 0
                        },
                        {
                            label: 'Speed (km/h / 10)',
                            data: chartDataSpeed.map(v => v / 10),
                            borderColor: '#eab308',
                            backgroundColor: 'transparent',
                            borderWidth: 1.5,
                            tension: 0.2,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                color: '#94a3b8',
                                font: { size: 10 }
                            }
                        }
                    },
                    scales: {
                        x: { display: false },
                        y: {
                            grid: { color: '#1e293b' },
                            ticks: {
                                color: '#64748b',
                                font: { size: 9 }
                            },
                            suggestedMax: 6,
                            suggestedMin: 0
                        }
                    }
                }
            });
        }

        // Setup Map Graphics
        function initMap() {
            canvas = document.getElementById('incidentMap');
            ctx = canvas.getContext('2d');
            resizeMap();
            
            // Listen to interactive clicks to set vehicle location
            canvas.addEventListener('mousedown', handleMapInteraction);
            canvas.addEventListener('touchstart', (e) => {
                e.preventDefault();
                handleMapInteraction(e.touches[0]);
            });

            // Re-render Loop
            setInterval(drawMap, 100);
        }

        function resizeMap() {
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);
        }

        // Map Interactivity Handler
        function handleMapInteraction(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.clientX - rect.left;
            const clientY = e.clientY - rect.top;

            // Convert raw pixel clicks back to percentages
            const pctX = (clientX / rect.width) * 100;
            const pctY = (clientY / rect.height) * 100;

            state.simCarX = pctX;
            state.simCarY = pctY;

            addSystemLog(`GPS Coordinates updated manually to [Lat: ${(37.7749 + (pctY - 50) * 0.001).toFixed(4)}°, Lon: ${(-122.4194 + (pctX - 50) * 0.001).toFixed(4)}°]`, "system");
            
            // Recalculate closest trauma network variables immediately
            recalculateClosestHospital();
        }

        // Dynamic coordinate distance calculator
        function recalculateClosestHospital() {
            let closestHosp = null;
            let minDistance = Infinity;

            hospitals.forEach(h => {
                // Euclidean distance logic on percentages
                const dist = Math.sqrt(Math.pow(state.simCarX - h.xPct, 2) + Math.pow(state.simCarY - h.yPct, 2));
                
                // Real-world calibration factor representation (e.g. 1% grid offset ~ 0.15 km)
                h.calculatedDist = (dist * 0.15).toFixed(1);
                // Simple travel eta rule (60 km/h average route speed ~ 1 minute per km)
                h.calculatedEta = Math.ceil(dist * 0.15 * 1.4);

                if (dist < minDistance) {
                    minDistance = dist;
                    closestHosp = h;
                }
            });

            // Update DOM layout details
            hospitals.forEach(h => {
                const distEl = document.getElementById(`hosp-dist-${h.id}`);
                const etaEl = document.getElementById(`hosp-eta-${h.id}`);
                const card = document.getElementById(h.elementId);

                if (distEl) distEl.innerText = `${h.calculatedDist} km`;
                if (etaEl) etaEl.innerText = `~${h.calculatedEta} mins`;

                if (card) {
                    if (h === closestHosp) {
                        card.className = "bg-slate-900 border-2 border-emerald-500/60 p-3 rounded-xl flex flex-col justify-between transition-all scale-[1.02] shadow-lg shadow-emerald-950/20";
                    } else {
                        card.className = "bg-slate-950/50 border border-slate-800 p-3 rounded-xl flex flex-col justify-between transition-all opacity-80 scale-100 hover:opacity-100";
                    }
                }
            });

            return closestHosp;
        }

        // Window resize listeners
        window.addEventListener('resize', () => {
            resizeMap();
            if (chartInstance) chartInstance.resize();
        });

        // Draw Map Infrastructure
        function drawMap() {
            const width = canvas.clientWidth;
            const height = canvas.clientHeight;
            ctx.clearRect(0, 0, width, height);

            // Draw roads/grid grid simulation lines
            ctx.strokeStyle = '#111827';
            ctx.lineWidth = 1;
            
            // Grid background
            for (let i = 0; i < width; i += 30) {
                ctx.beginPath();
                ctx.moveTo(i, 0);
                ctx.lineTo(i, height);
                ctx.stroke();
            }
            for (let j = 0; j < height; j += 30) {
                ctx.beginPath();
                ctx.moveTo(0, j);
                ctx.lineTo(width, j);
                ctx.stroke();
            }

            // Draw major highways (Road network)
            ctx.strokeStyle = '#020617';
            ctx.lineWidth = 14;
            ctx.beginPath();
            ctx.moveTo(30, height * 0.3);
            ctx.lineTo(width - 30, height * 0.3);
            
            ctx.moveTo(width * 0.4, 20);
            ctx.lineTo(width * 0.4, height - 20);

            ctx.moveTo(30, height * 0.8);
            ctx.lineTo(width - 30, height * 0.8);
            ctx.stroke();

            // Draw secondary road route vectors
            ctx.strokeStyle = '#0f172a';
            ctx.lineWidth = 8;
            ctx.beginPath();
            ctx.moveTo(width * 0.75, 10);
            ctx.lineTo(width * 0.75, height - 10);
            ctx.stroke();

            // Get closest hospital
            const closestHosp = recalculateClosestHospital();

            // Draw Hospital nodes
            hospitals.forEach(h => {
                const targetX = width * (h.xPct / 100);
                const targetY = height * (h.yPct / 100);

                ctx.fillStyle = h.color;
                ctx.beginPath();
                ctx.arc(targetX, targetY, 8, 0, Math.PI * 2);
                ctx.fill();

                // Outer signal ring animation for active beds integration
                ctx.strokeStyle = h.color;
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.arc(targetX, targetY, 8 + Math.abs(Math.sin(Date.now() / 400) * 10), 0, Math.PI * 2);
                ctx.stroke();

                // Hospital label
                ctx.fillStyle = '#94a3b8';
                ctx.font = 'bold 10px Inter';
                ctx.fillText(h.name.split(' ')[0], targetX - 22, targetY - 14);
            });

            // Draw Simulated Vehicle path & current status
            const carX = width * (state.simCarX / 100);
            const carY = height * (state.simCarY / 100);

            // If there's an ongoing crash scenario
            if (state.scenario === 'crash' || activeIncident) {
                // Flash alert pulse zone
                const pulseRadius = Math.abs(Math.sin(Date.now() / 200) * 25) + 12;
                ctx.fillStyle = 'rgba(239, 68, 68, 0.2)';
                ctx.beginPath();
                ctx.arc(carX, carY, pulseRadius, 0, Math.PI * 2);
                ctx.fill();

                ctx.strokeStyle = 'rgba(239, 68, 68, 0.8)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(carX, carY, pulseRadius, 0, Math.PI * 2);
                ctx.stroke();

                // Yellow routing line to the calculated closest hospital
                if (closestHosp) {
                    const hospX = width * (closestHosp.xPct / 100);
                    const hospY = height * (closestHosp.yPct / 100);

                    ctx.strokeStyle = '#eab308';
                    ctx.lineWidth = 2;
                    ctx.setLineDash([5, 5]);
                    ctx.beginPath();
                    ctx.moveTo(carX, carY);
                    ctx.lineTo(hospX, hospY);
                    ctx.stroke();
                    ctx.setLineDash([]); // Reset dash line

                    // Animated Dispatcher dot moving towards target
                    const travelProgress = (Date.now() % 3000) / 3000;
                    const dispatchX = carX + (hospX - carX) * travelProgress;
                    const dispatchY = carY + (hospY - carY) * travelProgress;

                    ctx.fillStyle = '#f59e0b';
                    ctx.beginPath();
                    ctx.arc(dispatchX, dispatchY, 6, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();
                }
            }

            // Draw the target car
            ctx.fillStyle = state.scenario === 'crash' ? '#f43f5e' : '#10b981';
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(carX, carY, 6, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
        }

        // Dynamic slider update bindings
        function updateConfig(param, val) {
            if (param === 'speed') {
                state.config.baselineSpeed = parseInt(val);
                document.getElementById('param-speed-val').innerText = `${val} km/h`;
            } else if (param === 'noise') {
                state.config.noiseLevel = parseInt(val);
                document.getElementById('param-noise-val').innerText = `${val}%`;
            } else if (param === 'threshold') {
                const calculatedG = (parseInt(val) / 10).toFixed(1);
                state.config.triggerThreshold = parseFloat(calculatedG);
                document.getElementById('param-threshold-val').innerText = `${calculatedG} G`;
            }
            addSystemLog(`Simulation configuration parameters adjusted: ${param} -> ${val}`, "system");
        }

        // Toggle Simulator loop status
        function toggleSimulationRun() {
            state.isSimulationRunning = !state.isSimulationRunning;
            const btn = document.getElementById('sim-run-btn');
            const icon = document.getElementById('sim-run-icon');
            const txt = document.getElementById('sim-run-text');

            if (state.isSimulationRunning) {
                btn.className = "bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-lg text-white font-semibold flex items-center gap-1.5 transition shadow";
                icon.className = "fa-solid fa-pause";
                txt.innerText = "Pause Stream";
                addSystemLog("Telemetry live data parser resumed.", "system");
            } else {
                btn.className = "bg-amber-600 hover:bg-amber-500 px-3 py-1.5 rounded-lg text-white font-semibold flex items-center gap-1.5 transition shadow";
                icon.className = "fa-solid fa-play";
                txt.innerText = "Resume Stream";
                addSystemLog("Telemetry stream suspended manually. Real-time chart frozen.", "system");
            }
        }

        function resetSimulationMetrics() {
            chartDataAcc.fill(1.0);
            chartDataGyro.fill(0.0);
            chartDataSpeed.fill(state.config.baselineSpeed);
            chartInstance.update();
            addSystemLog("Graph canvas and device data stats resetted.", "system");
        }

        // Control preset updates
        function setScenario(scen) {
            state.scenario = scen;
            
            // Highlight button
            document.querySelectorAll('.scenario-btn').forEach(btn => {
                btn.classList.remove('border-primary-500', 'bg-slate-750', 'ring-2', 'ring-rose-500');
            });
            const activeBtn = document.getElementById(`btn-${scen}`);
            if (activeBtn) {
                if (scen === 'crash') {
                    activeBtn.classList.add('ring-2', 'ring-rose-500');
                } else {
                    activeBtn.classList.add('border-primary-500', 'bg-slate-750');
                }
            }

            // Cancel any current countdown unless it's a new crash trigger
            if (scen !== 'crash' && state.isCountdownActive) {
                dismissCountdown();
            }

            // Action triggers on click
            if (scen === 'crash') {
                triggerCrashDetection();
            } else {
                activeIncident = null;
            }
        }

        // Set Connection States
        function setNetwork(status) {
            state.network = status;
            
            document.querySelectorAll('.net-btn').forEach(btn => {
                btn.className = "net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-slate-800 border-slate-700 text-slate-400 hover:bg-slate-750";
            });

            const activeBtn = document.getElementById(`net-${status}`);
            const resilienceModeLabel = document.getElementById('resilience-mode');

            if (status === 'online') {
                activeBtn.className = "net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-emerald-500/10 border-emerald-500/40 text-emerald-400";
                resilienceModeLabel.innerText = "ONLINE (CLOUDHUB INGESTION)";
                resilienceModeLabel.className = "text-xs font-bold text-emerald-400";
                
                // Flush buffer back to dispatch system
                flushBuffer();
            } else if (status === 'weak') {
                activeBtn.className = "net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-amber-500/10 border-amber-500/40 text-amber-400";
                resilienceModeLabel.innerText = "LOW BANDWIDTH (BUFFER ON-DEVICE)";
                resilienceModeLabel.className = "text-xs font-bold text-amber-400";
            } else {
                activeBtn.className = "net-btn py-2 px-2 rounded-lg text-xs font-medium transition border flex flex-col items-center gap-1 bg-rose-500/10 border-rose-500/40 text-rose-400";
                resilienceModeLabel.innerText = "OFFLINE SIGNAL (CELLULAR FALLBACK / SMS)";
                resilienceModeLabel.className = "text-xs font-bold text-rose-400 animate-pulse";
            }
            addSystemLog(`Router connection state shifted to: ${status.toUpperCase()}`, "system");
        }

        // Generate continuous stream values
        function runSimulationTick() {
            if (!state.isSimulationRunning) return;

            state.simulationTicks++;

            let nextAcc = 1.0;
            let nextGyro = 0.0;
            let nextSpeed = state.config.baselineSpeed;

            // Apply base road noise/vibration
            const noiseFactor = state.config.noiseLevel / 250; 

            // Compute physics based on preset modes
            switch (state.scenario) {
                case 'normal':
                    nextAcc = 1.0 + (Math.random() - 0.5) * noiseFactor;
                    nextGyro = (Math.random() - 0.5) * (noiseFactor * 50);
                    nextSpeed = state.config.baselineSpeed + Math.sin(state.simulationTicks / 10) * 4;
                    
                    // Vehicle drifts continuously on interactive canvas loop path
                    state.simCarX = (state.simCarX + 0.15) % 100;
                    break;
                case 'brake':
                    nextAcc = 0.4 + (Math.random() - 0.5) * 0.1;
                    nextGyro = (Math.random() - 0.5) * 3;
                    nextSpeed = Math.max(10, state.config.baselineSpeed - (state.simulationTicks % 15) * 6);
                    break;
                case 'pothole':
                    if (state.simulationTicks % 8 === 0) {
                        nextAcc = 3.6; // Temporary high-G spike
                        nextGyro = 32.0;
                    } else {
                        nextAcc = 1.0 + (Math.random() - 0.5) * noiseFactor;
                        nextGyro = (Math.random() - 0.5) * 5;
                    }
                    nextSpeed = Math.max(30, state.config.baselineSpeed - 12);
                    break;
                case 'crash':
                    // Extreme values representing severe multi-axis impact
                    nextAcc = 8.4 + (Math.random() - 0.5) * 1.5;
                    nextGyro = 145.0 + (Math.random() - 0.5) * 30;
                    nextSpeed = 0; // Instant stop
                    break;
            }

            // Update UI elements
            document.getElementById('readout-g').innerText = `${nextAcc.toFixed(2)} G`;
            document.getElementById('readout-gyro').innerText = `${nextGyro.toFixed(1)}°`;
            document.getElementById('readout-speed').innerText = `${Math.round(nextSpeed)} km/h`;

            // On-board AI Classifying logic (Simulating model thresholds dynamically)
            const aiStatusLabel = document.getElementById('ai-status-label');
            const aiConfidenceLabel = document.getElementById('ai-confidence-label');
            const featureVector = document.getElementById('feature-vector');
            const aiContainer = document.getElementById('ai-container');

            // Format feature vectors for display
            featureVector.innerText = `[${nextAcc.toFixed(2)}, ${nextGyro.toFixed(1)}, ${nextSpeed.toFixed(1)}, ${state.network === 'online' ? 1.0 : 0.0}]`;

            // Check against dynamic slider G alert threshold
            if (nextAcc >= state.config.triggerThreshold) {
                aiStatusLabel.innerText = "CRASH INFERENCE DETECTED!";
                aiConfidenceLabel.innerText = "98.7%";
                aiContainer.className = "bg-rose-950 border-rose-500 border-2 rounded-xl p-4 transition-all duration-300 animate-pulse shadow-lg shadow-rose-950/40";
                aiStatusLabel.className = "text-xl font-bold tracking-wide text-rose-400 mt-0.5";
            } else if (nextAcc > 2.2) {
                // Minor Anomaly Detected
                aiStatusLabel.innerText = "POTHOLE / MINOR IMPACT";
                aiConfidenceLabel.innerText = "91.2%";
                aiContainer.className = "bg-amber-950 border-amber-600 border rounded-xl p-4 transition-all duration-300";
                aiStatusLabel.className = "text-xl font-bold tracking-wide text-amber-400 mt-0.5";
            } else {
                // Normal
                aiStatusLabel.innerText = "NORMAL DRIVING";
                aiConfidenceLabel.innerText = "99.4%";
                aiContainer.className = "bg-slate-950/80 border border-slate-800 rounded-xl p-4 transition-all duration-300";
                aiStatusLabel.className = "text-xl font-bold tracking-wide text-emerald-400 mt-0.5";
            }

            // Push values to real-time charts
            chartDataAcc.shift();
            chartDataAcc.push(nextAcc);

            chartDataGyro.shift();
            chartDataGyro.push(nextGyro);

            chartDataSpeed.shift();
            chartDataSpeed.push(nextSpeed);

            chartInstance.update('none'); // Update without full redraw animation lag

            // Buffer packets dynamically when network connectivity degrades
            if (state.network === 'weak' && state.scenario === 'crash') {
                const telemetryPacket = {
                    time: new Date().toLocaleTimeString(),
                    g: nextAcc.toFixed(2),
                    gyro: nextGyro.toFixed(1),
                    speed: nextSpeed
                };
                state.bufferQueue.push(telemetryPacket);
                document.getElementById('buffer-count').innerText = `${state.bufferQueue.length} packets`;
            }
        }

        function triggerCrashDetection() {
            if (state.isCountdownActive) return;

            // Trigger visual warning
            state.isCountdownActive = true;
            state.countdownTime = 10;
            
            const countdownBanner = document.getElementById('countdown-banner');
            const countdownTimer = document.getElementById('countdown-timer');
            countdownBanner.classList.remove('hidden');

            speakAlert("Potential vehicle collision detected. Deploying automated telemetry triage sequence in ten seconds. Press dismiss if safe.");

            state.countdownTimerId = setInterval(() => {
                state.countdownTime--;
                countdownTimer.innerText = state.countdownTime;

                if (state.countdownTime <= 0) {
                    clearInterval(state.countdownTimerId);
                    escalateToCrisisCenter();
                }
            }, 1000);
        }

        // Dismiss mechanism (Mitigating False Positives)
        function dismissCountdown() {
            clearInterval(state.countdownTimerId);
            state.isCountdownActive = false;
            
            const countdownBanner = document.getElementById('countdown-banner');
            countdownBanner.classList.add('hidden');

            setScenario('normal');
            speakAlert("Emergency dispatch sequence aborted. Driver safe.");
            
            // Add cancellation log
            addSystemLog("False positive cancelled by occupant. Incident protocol halted.", "system");
        }

        function escalateToCrisisCenter() {
            state.isCountdownActive = false;
            document.getElementById('countdown-banner').classList.add('hidden');

            // Generate Emergency Incident Object
            const incidentId = "INC-" + Math.floor(100000 + Math.random() * 900000);
            const crashForce = chartDataAcc[chartLength - 1].toFixed(2);
            const crashSpeed = chartDataSpeed[chartLength - 2]; // Speed just before crash
            const closestHosp = recalculateClosestHospital();
            
            activeIncident = {
                id: incidentId,
                timestamp: new Date().toLocaleTimeString(),
                coordinates: `Lat: ${(37.7749 + (state.simCarY - 50) * 0.001).toFixed(4)}°, Lon: ${(-122.4194 + (state.simCarX - 50) * 0.001).toFixed(4)}°`,
                severity: "CRITICAL",
                gForce: crashForce,
                preSpeed: crashSpeed,
                status: "Pending Dispatch",
                networkType: state.network,
                hospital: closestHosp ? closestHosp.name : 'Unknown Hospital',
                eta: closestHosp ? `${closestHosp.calculatedEta} mins` : 'N/A'
            };

            speakAlert(`Critical Alert. Crash Incident confirmed with force of ${crashForce} G. Initiating dispatch to nearest center.`);

            // Route dynamically depending on active simulation network signal
            if (state.network === 'online') {
                transmitOnlineAlert(activeIncident);
            } else if (state.network === 'weak') {
                transmitWeakAlert(activeIncident);
            } else {
                transmitOfflineSMSAlert(activeIncident);
            }
        }

        // Transmit via MQTT/Cloud WebSockets
        function transmitOnlineAlert(incident) {
            incident.status = "Dispatched via Azure WebSockets";
            addSystemLog(`Incident ${incident.id} established routing link via active WebSockets.`, "crisis");
            addSystemLog(`Alert acknowledged by dispatchers. Nearest hospital: ${incident.hospital}. Ambulance dispatch confirmed. ETA: ${incident.eta}.`, "crisis");
            renderIncidentToFeed(incident);
        }

        // Low signal buffering scenario
        function transmitWeakAlert(incident) {
            incident.status = "Buffered locally / Ingested";
            addSystemLog(`Degraded data link detected. Compressing emergency incident payload parameters to 64-byte sequence.`, "crisis");
            addSystemLog(`Dispatch successfully processed over low-bandwidth cell. Hospital alerted: ${incident.hospital}.`, "crisis");
            renderIncidentToFeed(incident);
        }

        // Offline SMS Protocol Fail-Safe
        function transmitOfflineSMSAlert(incident) {
            incident.status = "Transmitted via Resilient SMS";
            
            // Generate SMS format
            const smsFallbackBox = document.getElementById('sms-fallback-box');
            smsFallbackBox.innerHTML = "";
            
            const smsPayload = `
<div class="p-2 border-b border-rose-950/40 text-[10px] text-rose-400">
    [OUTBOX: BROADCASTING SMS PROTOCOL]
</div>
<div class="p-2 bg-rose-950/25 rounded-lg border border-rose-500/30 text-[11px] space-y-1">
    <p class="font-bold text-white">&gt; TO: GSM_GATEWAY_309</p>
    <p>&gt; SMS_ENC: ID:${incident.id};FORCE:${incident.gForce}G;GPS:${(37.7749 + (state.simCarY - 50) * 0.001).toFixed(4)},${(-122.4194 + (state.simCarX - 50) * 0.001).toFixed(4)};ETA:${incident.eta}</p>
    <p class="text-[9px] text-slate-500">&gt; Compressed binary string size: 68 bytes</p>
</div>
<div class="p-1 text-[10px] text-emerald-400 text-right">
    <i class="fa-solid fa-check"></i> Dispatched via cellular emergency gateway
</div>
            `;
            smsFallbackBox.innerHTML = smsPayload;

            addSystemLog(`Zero data coverage! Initiating SMS-Fallback emergency gateway broadcast.`, "crisis");
            addSystemLog(`SMS routing package delivered to regional trauma units. Triage teams notified.`, "crisis");
            renderIncidentToFeed(incident);
        }

        function flushBuffer() {
            if (state.bufferQueue.length > 0) {
                addSystemLog(`System coverage restored. Transferring ${state.bufferQueue.length} on-device buffer logs back to cloud logs.`, "system");
                state.bufferQueue = [];
                document.getElementById('buffer-count').innerText = "0 packets";
            }
        }

        // Render logs dynamically based on criteria and state
        function renderIncidentToFeed(incident) {
            const emptyState = document.getElementById('logs-empty-state');
            if (emptyState) emptyState.remove();

            logQueue.unshift(incident);
            updateLogCount();
            renderFilteredLogs();
        }

        function setLogFilter(filter) {
            state.logFilter = filter;
            
            // Toggle highlight tabs
            document.querySelectorAll('[id^="log-filter-"]').forEach(btn => {
                btn.className = "px-2 py-0.5 rounded font-medium text-slate-400 hover:text-slate-200 transition";
            });
            const activeBtn = document.getElementById(`log-filter-${filter}`);
            if (activeBtn) activeBtn.className = "px-2 py-0.5 rounded font-medium bg-slate-800 text-white";

            renderFilteredLogs();
        }

        function renderFilteredLogs() {
            const feedContainer = document.getElementById('alert-logs');
            feedContainer.innerHTML = "";

            if (logQueue.length === 0) {
                feedContainer.innerHTML = `
                    <div id="logs-empty-state" class="h-full flex flex-col items-center justify-center text-center p-4">
                        <div class="w-12 h-12 rounded-full bg-slate-800/50 flex items-center justify-center text-slate-600 mb-2 border border-slate-800">
                            <i class="fa-solid fa-shield-halved text-xl"></i>
                        </div>
                        <p class="text-xs text-slate-400 font-medium">Ready &amp; Monitoring...</p>
                        <p class="text-[10px] text-slate-500 max-w-[180px] mt-1">No events match the selected criteria.</p>
                    </div>
                `;
                return;
            }

            logQueue.forEach(item => {
                // Check filters
                if (state.logFilter === 'crisis' && item.type !== 'crisis') return;
                if (state.logFilter === 'system' && item.type !== 'system') return;

                const card = document.createElement('div');
                
                if (item.type === 'system') {
                    // System Event Log
                    card.className = "p-2.5 bg-slate-950/45 rounded-xl border border-slate-850/80 text-[11px] flex gap-2 items-start";
                    card.innerHTML = `
                        <i class="fa-solid fa-gear text-slate-500 mt-0.5 animate-spin-slow"></i>
                        <div class="flex-1 text-slate-300">${item.text}</div>
                        <span class="text-[9px] text-slate-600 font-mono">${item.timestamp}</span>
                    `;
                } else {
                    // Crisis Crash incident log
                    let statusBadge = '';
                    let borderStyle = 'border-rose-500/40 bg-rose-500/5';
                    
                    if (item.networkType === 'online') {
                        statusBadge = `<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded font-bold text-[9px]">DISPATCHED (5G)</span>`;
                    } else if (item.networkType === 'weak') {
                        statusBadge = `<span class="bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded font-bold text-[9px]">DISPATCHED (LO-BW)</span>`;
                    } else {
                        statusBadge = `<span class="bg-rose-500/15 text-rose-400 border border-rose-500/30 px-2 py-0.5 rounded font-bold text-[9px]">SMS FALLBACK</span>`;
                    }

                    card.className = `p-3 rounded-xl border ${borderStyle} space-y-2 transition-all duration-300`;
                    card.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-[9px] text-slate-500 font-mono">${item.id}</span>
                                <h4 class="text-xs font-bold text-white mt-0.5">Critical Accident Triggered</h4>
                            </div>
                            <span class="text-[9px] font-mono text-slate-500">${item.timestamp}</span>
                        </div>

                        <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                            <div class="bg-slate-950/60 p-1 rounded border border-slate-800">
                                <span class="text-slate-500">Peak G:</span>
                                <span class="text-rose-400 font-bold">${item.gForce} G</span>
                            </div>
                            <div class="bg-slate-950/60 p-1 rounded border border-slate-800">
                                <span class="text-slate-500">Hospital:</span>
                                <span class="text-cyan-400 font-bold truncate block">${item.hospital.split(' ')[0]}</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center text-[10px] pt-1">
                            <span class="text-slate-400 flex items-center gap-1">
                                <i class="fa-solid fa-location-dot text-rose-500"></i> GPS: [${item.coordinates.replace('Lat: ', '').replace('Lon: ', '')}]
                            </span>
                            ${statusBadge}
                        </div>
                    `;
                }

                feedContainer.appendChild(card);
            });
        }

        function addSystemLog(message, type) {
            const systemEvent = {
                type: type === 'crisis' ? 'crisis' : 'system',
                text: message,
                timestamp: new Date().toLocaleTimeString()
            };

            logQueue.unshift(systemEvent);
            updateLogCount();
            renderFilteredLogs();
        }

        function updateLogCount() {
            document.getElementById('log-stat-count').innerText = logQueue.length;
        }

        function exportLogQueue() {
            if (logQueue.length === 0) {
                speakAlert("No log payloads generated to export.");
                return;
            }
            const logsData = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(logQueue, null, 2));
            const dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", logsData);
            dlAnchor.setAttribute("download", `SirenNet_Log_Export_${Date.now()}.json`);
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
            
            addSystemLog("Incident logs database exported successfully.", "system");
        }

        // Audio synthesizer controller
        function toggleAudioMute() {
            state.isAudioMuted = !state.isAudioMuted;
            const icon = document.getElementById('audio-icon');
            if (state.isAudioMuted) {
                icon.className = "fa-solid fa-volume-xmark text-slate-500";
                addSystemLog("TTS audio alerts muted.", "system");
            } else {
                icon.className = "fa-solid fa-volume-high text-rose-400";
                addSystemLog("TTS audio alerts unmuted.", "system");
                speakAlert("Audio notification dispatcher configured.");
            }
        }

        function testCustomVoice() {
            speakAlert("SirenNet audio synthesiser check configured successfully.");
        }

        function speakAlert(text) {
            if (state.isAudioMuted) return;
            if ('speechSynthesis' in window) {
                // Cancel active utterances first to keep queue real-time responsive
                window.speechSynthesis.cancel();

                const utterance = new SpeechSynthesisUtterance(text);
                
                // Fetch values from dynamic Voice Customizer range inputs
                const customPitch = parseFloat(document.getElementById('tts-pitch').value);
                const customRate = parseFloat(document.getElementById('tts-rate').value);

                utterance.pitch = customPitch || 1.0;
                utterance.rate = customRate || 1.1;

                window.speechSynthesis.speak(utterance);
            }
        }

        // Initialize App loop on window ready
        window.onload = function() {
            initChart();
            initMap();
            
            // Continuous simulation loop calculations running at 7Hz
            setInterval(runSimulationTick, 140);
        };
    </script>
</body>
</html>
